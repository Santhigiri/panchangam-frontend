# Base URL of the panchangam-api backend (see https://github.com/santhigiri/panchangam-api)
VITE_APP_BASE_URL=http://localhost:8000

# Google Maps Platform API key used by the Starfinder location search.
# Requires "Places API", "Maps JavaScript API", and "Time Zone API" enabled,
# and should be restricted by HTTP referrer since it is used client-side.
VITE_GOOGLE_MAPS_API_KEY=
